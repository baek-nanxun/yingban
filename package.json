{
  "name": "yingban-windows",
  "version": "1.0.3",
  "private": true,
  "description": "映伴 · Windows 双人屏幕共享与人声优先原型",
  "repository": {
    "type": "git",
    "url": "https://github.com/baek-nanxun/yingban-windows.git"
  },
  "homepage": "https://github.com/baek-nanxun/yingban-windows/releases",
  "main": "app/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "start": "npm run build:native && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "dist": "npm run build:native && node scripts/package.cjs",
    "dist:installer": "npm run build:native && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "playwright": "1.56.1",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.yingban.windows",
    "productName": "映伴",
    "executableName": "YingBan",
    "icon": "app/icon.ico",
    "protocols": [
      {
        "name": "映伴邀请",
        "schemes": [
          "yingban",
          "clearcall"
        ]
      }
    ],
    "asar": true,
    "files": [
      "app/**/*",
      "package.json",
      "node_modules/ws/**/*",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "native/bin/YingBan.Audio.exe",
        "to": "native/bin/YingBan.Audio.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YingBan-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "映伴"
    }
  },
  "license": "MIT"
}
