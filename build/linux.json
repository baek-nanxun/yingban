{
  "appId": "com.yingban.desktop",
  "productName": "映伴",
  "executableName": "yingban",
  "asar": true,
  "files": ["app/**/*", "package.json", "node_modules/ws/**/*", "LICENSE"],
  "protocols": [{ "name": "映伴邀请", "schemes": ["yingban", "clearcall"] }],
  "directories": { "output": "dist-linux" },
  "linux": {
    "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
    "icon": "app/icon.png",
    "category": "Network",
    "maintainer": "baek-nanxun",
    "artifactName": "YingBan-${version}-linux-${arch}.${ext}"
  },
  "deb": { "maintainer": "baek-nanxun", "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "pulseaudio-utils"] }
}
